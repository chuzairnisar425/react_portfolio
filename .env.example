# Copy this file to .env.local for local development, and add the same
# variables in Netlify (Site configuration > Environment variables).

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where contact form messages are delivered.
CONTACT_TO=uzair.nisar484@gmail.com

# Optional. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which only delivers to the email you signed up to Resend with.
# Once you verify a domain in Resend, use an address on it, e.g.
# CONTACT_FROM=Portfolio <hello@yourdomain.com>
CONTACT_FROM=
